{
    "name": "privatus/bolt-privatus-analytics",
    "description": "See how many real people visit your Bolt CMS site, without cookies. Adds the Privatus Analytics script to every front-end page.",
    "type": "bolt-extension",
    "keywords": [
        "bolt",
        "bolt-extension",
        "boltcms",
        "extension",
        "analytics",
        "privacy",
        "cookieless",
        "privatus"
    ],
    "homepage": "https://privatusanalytics.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Privatus Analytics",
            "homepage": "https://privatusanalytics.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Privatus-Analytics/bolt-privatus-analytics/issues",
        "source": "https://github.com/Privatus-Analytics/bolt-privatus-analytics",
        "docs": "https://privatusanalytics.com/docs"
    },
    "require": {
        "php": ">=8.2",
        "privatus/analytics": "^1.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Privatus\\BoltAnalytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Privatus\\BoltAnalytics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "entrypoint": "Privatus\\BoltAnalytics\\Extension"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
